# Copy to .env.prod on the server and fill in. Never commit .env.prod.

# Your domain, or <server-ip>.sslip.io if you don't have one (e.g. 203.0.113.7.sslip.io).
DOMAIN=
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Limits for the public demo
ASK_DAILY_LIMIT=100
ASK_RATE_LIMIT=60/hour

# Path of Building: processes kept warm (each ~300 MB RAM). 1 on a 4 GB server
# (CX23); 2 on 8 GB.
POB_POOL_SIZE=1

# Optional: error tracking (sentry.io free tier). No personal data or request bodies are sent.
# SENTRY_DSN=

# Optional: proxies for fetch_wiki / refresh_wiki (comma-separated), in addition to
# proxies/proxies.txt on the server (mounted into the container).
# WIKI_PROXIES=http://user:pass@host:port,socks5://host:port
