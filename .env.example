# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# docker-compose overrides these two for the containers.
DATABASE_URL=postgres://build_advisor:build_advisor@localhost:5432/build_advisor
CELERY_BROKER_URL=redis://localhost:6379/0

# Path of Exile wiki (poewiki.net). Put a contact address in the user agent.
WIKI_USER_AGENT=build-advisor/0.1 (non-commercial portfolio project; you@example.com)
WIKI_REQUEST_INTERVAL=2.5
# Grows on rate limiting (up to this many seconds), then recovers slowly.
WIKI_MAX_REQUEST_INTERVAL=30
# Optional comma-separated proxies. Each download thread gets its own proxy and
# switches to another one when its proxy fails.
WIKI_PROXIES=
# Or put them in a text file, one per line (default: proxies.txt in the project root).
# WIKI_PROXY_FILE=proxies.txt
# Download threads, each with its own proxy (default: 4 with proxies, 1 without; max 16).
# WIKI_WORKERS=4
# Seconds a failed proxy is skipped before it's tried again.
WIKI_PROXY_COOLDOWN=300
# Leave empty to use the latest released version from the wiki.
POE_PATCH=

# Embeddings (bge-m3, 1024 dimensions). Device: auto | cuda | cpu
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
CHUNK_MAX_CHARS=1500

# LLM. Provider: deepseek | openai | anthropic. Model names change between
# generations, so check your provider's docs (DeepSeek: deepseek-flash or deepseek-v4-pro).
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Optional: override the provider's default base URL.
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
# Provider-specific request options as JSON.
LLM_EXTRA_BODY={}

# Path of Building tools (pob-mcp). The Docker image includes PoB and sets POB_PATH;
# outside Docker, point it at a PathOfBuilding checkout. POB_ENABLED=false turns tools off.
# POB_PATH=
# POB_ENABLED=true
POB_POOL_SIZE=1
POB_TOOL_TIMEOUT=90
POB_MAX_TOOL_ROUNDS=8

# Rewrite questions into wiki terms before searching (on when LLM_API_KEY is set).
# SEARCH_QUERY_REWRITE=true

# Requests per IP to /api/ask/.
ASK_RATE_LIMIT=60/hour
# Questions per day for the whole site (resets at midnight UTC); 0 = no limit.
ASK_DAILY_LIMIT=100
