# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# docker-compose overrides these two for the containers.
DATABASE_URL=postgres://build_advisor:build_advisor@localhost:5432/build_advisor
CELERY_BROKER_URL=redis://localhost:6379/0

# Path of Exile wiki (poewiki.net). Put a contact address in the user agent.
WIKI_USER_AGENT=build-advisor/0.1 (non-commercial portfolio project; you@example.com)
WIKI_REQUEST_INTERVAL=1.0
# Leave empty to use the latest released version from the wiki.
POE_PATCH=

# LLM (phase 3+). The model name is configured here, never in code.
LLM_PROVIDER=deepseek
LLM_MODEL=
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
